{
  "display_information": {
    "name": "Vivido Assistant",
    "description": "Consegna le routine PM di Vivido (daily, weekly, EOD, LinkedIn) via DM Slack.",
    "background_color": "#1a1a1a"
  },
  "features": {
    "bot_user": {
      "display_name": "vivido_assistant",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
