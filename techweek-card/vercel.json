{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/me",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/samuele.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Samuele Poggio.vcf\""
        }
      ]
    },
    {
      "source": "/alessandro.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Alessandro Martinengo.vcf\""
        }
      ]
    }
  ]
}
