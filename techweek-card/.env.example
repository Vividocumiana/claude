# Whose card this deploy is: samuele (default) | alessandro — see people/
CARD=samuele

# Notion (optional) — leave both unset to skip saving contacts (then /me is disabled
# and the form only sends the email). Internal integration token + database id.
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend — API key; FROM must use a domain verified in Resend
RESEND_API_KEY=re_xxx
MAIL_FROM="Samuele from Vivido <samuele@vivido.world>"
MAIL_REPLY_TO=samuele@vivido.world

# Public URL of the deploy (used for images and links inside the email)
PUBLIC_URL=https://samuele.vivido.world

# Booking link used in the email button
BOOKING_URL=https://cal.com/vivido-wdkm3m/general-vivido?overlayCalendar=true

# PIN for the private view (/me). At least 4 digits.
ADMIN_PIN=0000

# Event tag saved on each contact
EVENT_NAME=Tech Week
